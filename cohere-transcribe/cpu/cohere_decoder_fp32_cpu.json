{
    "input_model": {
        "type": "PyTorchModel",
        "model_path": "CohereLabs/cohere-transcribe-03-2026",
        "model_loader": "decoder_model_loader",
        "model_script": "cpu/cohere_model_load.py",
        "io_config": {
            "input_names": [
                "input_ids", "past_sequence_length",
                "past_key_self_0", "past_value_self_0",
                "past_key_self_1", "past_value_self_1",
                "past_key_self_2", "past_value_self_2",
                "past_key_self_3", "past_value_self_3",
                "past_key_self_4", "past_value_self_4",
                "past_key_self_5", "past_value_self_5",
                "past_key_self_6", "past_value_self_6",
                "past_key_self_7", "past_value_self_7",
                "past_key_cross_0", "past_value_cross_0",
                "past_key_cross_1", "past_value_cross_1",
                "past_key_cross_2", "past_value_cross_2",
                "past_key_cross_3", "past_value_cross_3",
                "past_key_cross_4", "past_value_cross_4",
                "past_key_cross_5", "past_value_cross_5",
                "past_key_cross_6", "past_value_cross_6",
                "past_key_cross_7", "past_value_cross_7"
            ],
            "output_names": [
                "logits",
                "present_key_self_0", "present_value_self_0",
                "present_key_self_1", "present_value_self_1",
                "present_key_self_2", "present_value_self_2",
                "present_key_self_3", "present_value_self_3",
                "present_key_self_4", "present_value_self_4",
                "present_key_self_5", "present_value_self_5",
                "present_key_self_6", "present_value_self_6",
                "present_key_self_7", "present_value_self_7"
            ],
            "dynamic_axes": {
                "input_ids": {"0": "batch", "1": "n_tokens"},
                "logits": {"0": "batch", "1": "n_tokens"},
                "past_key_cross_0": {"0": "batch", "2": "T_enc"},
                "past_value_cross_0": {"0": "batch", "2": "T_enc"},
                "past_key_cross_1": {"0": "batch", "2": "T_enc"},
                "past_value_cross_1": {"0": "batch", "2": "T_enc"},
                "past_key_cross_2": {"0": "batch", "2": "T_enc"},
                "past_value_cross_2": {"0": "batch", "2": "T_enc"},
                "past_key_cross_3": {"0": "batch", "2": "T_enc"},
                "past_value_cross_3": {"0": "batch", "2": "T_enc"},
                "past_key_cross_4": {"0": "batch", "2": "T_enc"},
                "past_value_cross_4": {"0": "batch", "2": "T_enc"},
                "past_key_cross_5": {"0": "batch", "2": "T_enc"},
                "past_value_cross_5": {"0": "batch", "2": "T_enc"},
                "past_key_cross_6": {"0": "batch", "2": "T_enc"},
                "past_value_cross_6": {"0": "batch", "2": "T_enc"},
                "past_key_cross_7": {"0": "batch", "2": "T_enc"},
                "past_value_cross_7": {"0": "batch", "2": "T_enc"}
            }
        },
        "dummy_inputs_func": "decoder_dummy_inputs"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "cpu",
                    "execution_providers": ["CPUExecutionProvider"]
                }
            ]
        }
    },
    "passes": {
        "convert": {
            "type": "OnnxConversion",
            "target_opset": 17,
            "use_dynamo_exporter": false,
            "dynamic": true,
            "save_as_external_data": true,
            "all_tensors_to_one_file": true,
            "external_data_name": "decoder.onnx.data"
        }
    },
    "target": "local_system",
    "output_dir": "build/onnx_models_fp32/decoder.onnx",
    "no_artifacts": true
}
